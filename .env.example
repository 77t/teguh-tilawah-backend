# Salin isi file ini ke Vercel -> Project Settings -> Environment Variables.
# JANGAN commit file .env asli (berisi nilai sungguhan) ke GitHub -- file ini
# (.env.example) cuma contoh nama variabelnya, nilainya sengaja dikosongkan.

# --- Pencarian produk (api/search.js) ---
APIFY_TOKEN=
APIFY_ACTOR_ID=

# --- Konversi link afiliasi Shopee (lib/shopeeAffiliate.js) ---
# Isi kalau akun Shopee Affiliate Anda sudah punya akses Open API.
# Kalau belum, kosongkan dulu -- pencarian tetap jalan, link produk apa
# adanya (belum ber-komisi) sampai Anda isi ini.
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# --- Tiker donasi (api/saweria-webhook.js, api/recent-donations.js) ---
# Personal Access Token GitHub dengan scope "repo" (Settings -> Developer
# settings -> Personal access tokens di akun GitHub Anda).
GITHUB_TOKEN=
GITHUB_REPO=namaUser/namaRepo
GITHUB_FILE_PATH=data/donations.json
GITHUB_BRANCH=main
